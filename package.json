{
  "name": "@yannickyamo/atelier",
  "version": "0.5.0",
  "description": "Reproduce a writing taste at scale: learn a standard from the writing you choose, approve it once, and hold every AI draft to it.",
  "type": "module",
  "bin": {
    "atelier": "./dist/cli/atelier.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "MEASUREMENTS.md",
    "SECURITY.md",
    "docs",
    "examples",
    "studies",
    "!studies/harness"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli/atelier.mjs', 0o755)\"",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:plugins": "tsx plugins/build-plugins.mts",
    "pretest": "npm run build:plugins && npm run build",
    "acceptance:carriers": "tsx scripts/carrier-acceptance.mts",
    "ablation:carrier": "tsx scripts/ablation-carrier.mts",
    "preflight": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yannickYamo/atelier.git"
  },
  "homepage": "https://github.com/yannickYamo/atelier#readme",
  "bugs": {
    "url": "https://github.com/yannickYamo/atelier/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "skills",
    "llm",
    "claude",
    "codex",
    "expert-systems",
    "prompt-compiler",
    "agent-skills"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
