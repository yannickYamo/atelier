  {
   "requirementId": "x2",
   "statement": "Then a Facts section. Every fact cites the document in the file it comes from, in square brackets: [notice of loss], [police report], [invoice 1].",
   "appliesWhen": "GENERAL",
   "kind": "GENERATIVE",
   "authority": "EXPERT_AUTHORED",
   "provenance": "EXPERT_STATED",
   "evidence": null,
   "evidenceItemId": null,
   "wouldBeAbsentIf": null,
   "materiality": "REQUIRED",
   "realizationTolerance": null,
   "outputShape": null,
   "obligation": "DELIVERABLE",
   "measurement": {
    "observer": "CHECK",
    "params": {
     "source": [
      "(text, request, material) => { const names = material.map(m => m.name.toLowerCase().replace(/\\.[^.]+$/,'').replace(/[-_]/g,' ').trim()); const m = text.match(/##\\s*Facts\\s*\\n([\\s\\S]*?)(?=\\n##\\s|$)/i); if (!m) return null; const body = m[1]; const start = text.indexOf(m[1]); const sents = body.split(/(?<=[.!?])\\s+/).filter(s => s.trim()); const bad = []; let at = start; for (const s of sents) { const idx = text.indexOf(s, at); const cites = [...s.matchAll(/\\[([^\\]]+)\\]/g)].map(x => x[1].toLowerCase().trim()); const known = cites.some(c => names.some(n => n === c || n.includes(c) || c.includes(n))); if (!known) bad.push({start: idx, end: idx + s.length, why: 'fact without a citation to a file document'}); at = idx + s.length; } return { ok: bad.length === 0, detail: bad.length ? bad.length + ' uncited fact sentence(s)' : 'every fact cites a file document', spans: bad }; }"
     ],
     "means": [
      "Every sentence in the Facts section carries at least one bracketed citation naming a document in the material."
     ]
    }
   }
  },
  {
   "requirementId": "x3",
   "statement": "Then a Coverage analysis section. The coverage conclusion cites the policy clause it rests on, and every exclusion that could apply is addressed and cited.",
