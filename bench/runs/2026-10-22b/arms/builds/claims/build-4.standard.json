  {
   "requirementId": "x8",
   "statement": "Take every date, name and figure from the file: add none of your own.",
   "appliesWhen": "GENERAL",
   "kind": "BOUNDARY",
   "authority": "EXPERT_AUTHORED",
   "provenance": "EXPERT_STATED",
   "evidence": null,
   "evidenceItemId": null,
   "wouldBeAbsentIf": null,
   "materiality": null,
   "realizationTolerance": null,
   "outputShape": null,
   "obligation": "DELIVERABLE",
   "measurement": {
    "observer": "CHECK",
    "params": {
     "source": [
      "(text, request, material) => {",
      "  const corpus = material.map(m => m.text).join(' ') + ' ' + (request || '');",
      "  const norm = s => s.replace(/,/g, '');",
      "  const corpusNums = new Set([...norm(corpus).matchAll(/\\d+(?:\\.\\d+)?/g)].map(m => m[0]));",
      "  const bad = [];",
      "  const re = /\\b\\d{1,3}(?:,\\d{3})+(?:\\.\\d+)?\\b|\\b\\d+(?:\\.\\d+)?\\b/g;",
      "  const reserveStart = text.search(/##\\s*Reserve/i);",
      "  let m;",
      "  while ((m = re.exec(text))) {",
      "    const v = m[0].replace(/,/g, '');",
      "    const before = text.slice(Math.max(0, m.index - 12), m.index).toLowerCase();",
      "    // Clause, exclusion, section, invoice and policy/reference labels are identifiers, not figures",
      "    if (/(clause|exclusion|section|invoice|cover|policy|reference|ref|no\\.?|#)\\s*$/.test(before)) continue;",
      "    // Dates: a day/month/year written in the text counts as found if its parts appear in the file",
      "    const after = text.slice(m.index + m[0].length, m.index + m[0].length + 12).toLowerCase();",
      "    if (/^\\s*(january|february|march|april|may|june|july|august|september|october|november|december)/.test(after)) {",
      "      const months = ['january','february','march','april','may','june','july','august','september','october','november','december'];",
      "      const monthHit = months.some(mo => corpus.toLowerCase().includes(mo));",
      "      if (monthHit && corpusNums.has(v)) continue;",
      "    }",
      "    // Sums in the Reserve section may be totals of two or more figures found in the file",
      "    if (reserveStart >= 0 && m.index > reserveStart) {",
      "      const nums = [...norm(corpus).matchAll(/\\d+(?:\\.\\d+)?/g)].map(x => Number(x[0]));",
      "      const target = Number(v);",
      "      let found = corpusNums.has(v);",
      "      for (let i = 0; i < nums.length && !found; i++) {",
      "        for (let j = i + 1; j < nums.length && !found; j++) {",
      "          if (nums[i] + nums[j] === target) found = true;",
      "        }",
      "      }",
      "      if (found) continue;",
      "    }",
      "    if (!corpusNums.has(v)) {",
      "      bad.push({ start: m.index, end: m.index + m[0].length, why: 'figure not found in the file or request' });",
      "    }",
      "  }",
      "  return {",
      "    ok: bad.length === 0,",
      "    detail: bad.length ? bad.length + ' figure(s) not found in the file' : 'every figure is in the file or request',",
      "    spans: bad",
      "  };",
      "}"
     ],
     "means": [
      "Every number in the memo appears in the material or request; sums in the Reserve section may need a judgement allowance."
     ]
    }
   }
  },
