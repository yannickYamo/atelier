    "params": {
     "source": [
      "(text) => { const re = /\\b(intent(?:ion|ional|ionally)?|honest(?:y|ly)?|dishonest(?:y|ly)?|motive[sd]?|deliberate(?:ly)?|lying|lied|lie|cover[- ]?up|trying to|wanted to|meant to)\\b/gi; const spans = []; let m; while ((m = re.exec(text))) spans.push({ start: m.index, end: m.index + m[0].length, why: 'speculation about intent or honesty' }); return { ok: spans.length === 0, detail: spans.length ? spans.length + ' speculative phrase(s) about intent or honesty' : 'no speculation about intent or honesty', spans }; }"
     ],
     "means": [
      "No words about the insured's intent, motive or honesty appear in the text."
     ]
    }
   }
