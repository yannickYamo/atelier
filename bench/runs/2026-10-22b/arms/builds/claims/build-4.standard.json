  {
   "requirementId": "x5",
   "statement": "End with a Reserve section. The reserve equals the sum of the invoices in the file, less any excess the schedule applies, and cites the invoices.",
   "appliesWhen": "GENERAL",
   "kind": "GENERATIVE",
   "authority": "EXPERT_AUTHORED",
   "provenance": "EXPERT_STATED",
   "evidence": null,
   "evidenceItemId": null,
   "wouldBeAbsentIf": null,
   "materiality": null,
   "realizationTolerance": null,
   "outputShape": null,
   "obligation": "DELIVERABLE",
   "measurement": {
    "observer": "CHECK",
    "params": {
     "source": [
      "(text, request, material) => {",
      "  const sec = text.match(/##\\s*Reserve\\s*\\n([\\s\\S]*?)(?=\\n##\\s|$)/i);",
      "  if (!sec) return { ok: true, detail: 'no Reserve section', spans: [] };",
      "  const body = sec[1];",
      "  if (/no reserve/i.test(body)) return { ok: true, detail: 'no reserve set; claim declined', spans: [] };",
      "  const nums = s => [...s.matchAll(/\\d{1,3}(?:,\\d{3})+|\\d+(?:\\.\\d+)?/g)].map(m => parseFloat(m[0].replace(/,/g, '')));",
      "  const invoiceAmounts = [];",
      "  for (const m of material) {",
      "    if (!/invoice/i.test(m.name)) continue;",
      "    const amts = [...m.text.matchAll(/(?:amount|total)\\s*:?\\s*(\\d{1,3}(?:,\\d{3})+|\\d+(?:\\.\\d+)?)/gi)].map(x => parseFloat(x[1].replace(/,/g, '')));",
      "    if (amts.length) invoiceAmounts.push(amts[amts.length - 1]);",
      "  }",
      "  if (invoiceAmounts.length === 0) return {};",
      "  const total = invoiceAmounts.reduce((a, b) => a + b, 0);",
      "  const figs = nums(body);",
      "  const ok = figs.includes(total) || figs.some(f => f > total);",
      "  return {",
      "    ok,",
      "    detail: ok ? 'reserve figure present; invoice sum ' + total : 'reserve does not reflect invoice sum ' + total,",
      "    spans: ok ? [] : [{ start: text.indexOf(body), end: text.indexOf(body) + body.length, why: 'reserve figure absent or not based on the invoices in the file' }]",
      "  };",
      "}"
     ],
     "means": [
      "The Reserve section contains the sum of the invoice totals found in the material; excess deduction is left to judgement."
     ]
    }
   }
  },
  {
