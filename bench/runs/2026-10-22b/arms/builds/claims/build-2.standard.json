      "(text, request, material) => { const hay = material.map(m=>m.text).join(' ').toLowerCase(); const dates = [...text.matchAll(/\\b\\d{1,2}\\s+(?:january|february|march|april|may|june|july|august|september|october|november|december)\\s+\\d{4}\\b/gi)].map(m=>m[0]); const bad = []; for (const d of dates) { const parts = d.toLowerCase().split(/\\s+/); const day = String(parseInt(parts[0],10)); if (!hay.includes(parts[1]) || !hay.includes(parts[2]) || !hay.includes(day)) bad.push({start:text.indexOf(d), end:text.indexOf(d)+d.length, why:'date not found in material: '+d}); } return {ok: bad.length===0, detail: bad.length ? bad.length+' date(s) not in material' : 'all dates trace to the material', spans: bad}; }"
     ],
