  {
   "requirementId": "x5",
   "statement": "End with a Reserve section. The reserve equals the sum of the invoices in the file, less any excess the schedule applies, and cites the invoices.",
   "appliesWhen": "GENERAL",
   "kind": "GENERATIVE",
   "authority": "EXPERT_AUTHORED",
   "provenance": "EXPERT_STATED",
   "evidence": null,
   "evidenceItemId": null,
   "wouldBeAbsentIf": null,
   "materiality": null,
   "realizationTolerance": null,
   "outputShape": null,
   "obligation": "DELIVERABLE",
   "measurement": {
    "observer": "CHECK",
    "params": {
     "source": [
      "(text, request, material) => {",
      "  const start = text.search(/^##\\s*Reserve/mi);",
      "  if (start < 0) return { ok: true, detail: 'no Reserve section to check', spans: [] };",
      "  const rest = text.slice(start);",
      "  const after = rest.replace(/^##[^\\n]*\\n/, '');",
      "  const nextHeading = after.search(/^##\\s/m);",
      "  const body = nextHeading >= 0 ? after.slice(0, nextHeading) : after;",
      "  if (/no reserve|not set|declined/i.test(body) && !/[0-9]/.test(body)) {",
      "    return { ok: true, detail: 'reserve not set; no amount required', spans: [] };",
      "  }",
      "  const invoices = material.filter(d => /invoice/i.test(d.name));",
      "  const amounts = [];",
      "  for (const doc of invoices) {",
      "    const m = [...doc.text.matchAll(/(?:total|amount)\\s*:?\\s*([0-9][0-9,]*(?:\\.[0-9]+)?)/gi)];",
      "    if (m.length) amounts.push(parseFloat(m[m.length - 1][1].replace(/,/g, '')));",
      "  }",
      "  const sum = amounts.reduce((a, b) => a + b, 0);",
      "  const stated = [...body.matchAll(/\\$?\\s*([0-9][0-9,]*(?:\\.[0-9]+)?)\\s*(?:dollars)?/gi)]",
      "    .map(x => parseFloat(x[1].replace(/,/g, '')))",
      "    .filter(v => !isNaN(v));",
      "  const bad = [];",
      "  if (amounts.length && !stated.some(v => Math.abs(v - sum) < 0.01)) {",
      "    bad.push({ start, end: start + 20, why: 'reserve does not equal the sum of the invoices (' + sum + ')' });",
      "  }",
      "  const invCited = /\\[[^\\]]*invoice[^\\]]*\\]/i.test(body);",
      "  if (!invCited) bad.push({ start, end: start + 20, why: 'Reserve cites no invoice' });",
      "  return {",
      "    ok: bad.length === 0,",
      "    detail: bad.length ? bad.map(b => b.why).join('; ') : 'reserve matches invoice sum and cites invoices',",
      "    spans: bad",
      "  };",
      "}"
     ],
     "means": [
      "The Reserve section states an amount equal to the sum of the totals in the invoice documents in the file, and cites an invoice; excess is left to a person to check."
     ]
    }
   }
  },
