  {
   "requirementId": "x2",
   "statement": "Then a Facts section. Every fact cites the document in the file it comes from, in square brackets: [notice of loss], [police report], [invoice 1].",
   "appliesWhen": "GENERAL",
   "kind": "GENERATIVE",
   "authority": "EXPERT_AUTHORED",
   "provenance": "EXPERT_STATED",
   "evidence": null,
   "evidenceItemId": null,
   "wouldBeAbsentIf": null,
   "materiality": null,
   "realizationTolerance": null,
   "outputShape": null,
   "obligation": "DELIVERABLE",
   "measurement": {
    "observer": "CHECK",
    "params": {
     "source": [
      "(text, request, material) => {",
      "  const norm = s => s.toLowerCase().replace(/\\.[a-z0-9]+$/, '').replace(/[-_\\s]+/g, ' ').trim();",
      "  const names = material.map(m => norm(m.name));",
      "  const m = text.match(/##\\s*Facts\\s*\\n([\\s\\S]*?)(?=\\n##\\s|$)/i);",
      "  if (!m) return null;",
      "  const body = m[1];",
      "  const sents = body.split(/(?<=[.!?])\\s+/).filter(s => s.trim());",
      "  const bad = [];",
      "  let pos = 0;",
      "  for (const s of sents) {",
      "    const idx = body.indexOf(s, pos);",
      "    pos = idx + s.length;",
      "    const cites = [...s.matchAll(/\\[([^\\]]+)\\]/g)].map(x => norm(x[1]).replace(/ \\d+$/, ''));",
      "    const ok = cites.length > 0 && cites.every(c => names.some(n => n === c || n.startsWith(c + ' ') || n.startsWith(c) || c.startsWith(n)));",
      "    if (!ok) bad.push({ start: idx, end: idx + s.length, why: 'fact without a cited document in the file' });",
      "  }",
      "  return {",
      "    ok: bad.length === 0,",
      "    detail: bad.length ? bad.length + ' uncited fact sentence(s)' : 'every fact sentence cites a file document',",
      "    spans: bad",
      "  };",
      "}"
     ],
     "means": [
      "Every sentence in the Facts section carries a bracketed document name that matches a file in the material."
     ]
    }
   }
  },
  {
   "requirementId": "x3",
   "statement": "Then a Coverage analysis section. The coverage conclusion cites the policy clause it rests on, and every exclusion that could apply is addressed and cited.",
   "appliesWhen": "GENERAL",
   "kind": "GENERATIVE",
   "authority": "EXPERT_AUTHORED",
   "provenance": "EXPERT_STATED",
   "evidence": null,
   "evidenceItemId": null,
   "wouldBeAbsentIf": null,
   "materiality": null,
   "realizationTolerance": null,
   "outputShape": null,
   "obligation": "DELIVERABLE",
   "measurement": {
    "observer": "CHECK",
    "params": {
     "source": [
      "(text, request, material) => { const start = text.search(/^##\\s*Coverage analysis/mi); if (start < 0) return { ok: false, detail: 'no Coverage analysis section', spans: [] }; const rest = text.slice(start); const next = rest.slice(3).search(/^##\\s/m); const body = next < 0 ? rest : rest.slice(0, next + 3); const hasClause = /clause\\s+\\d+(\\.\\d+)?|exclusion\\s+\\d+(\\.\\d+)?/i.test(body); const cited = /\\[[^\\]]+\\]/.test(body); return { ok: hasClause && cited, detail: hasClause && cited ? 'clause cited with source' : 'no policy clause or no citation in Coverage analysis', spans: [] }; }"
     ],
     "means": [
      "The Coverage analysis section names a policy clause number and carries at least one bracketed citation; whether every applicable exclusion is addressed is judged by a person."
     ]
    }
   }
  },
  {
   "requirementId": "x4",
